    },
    "tenant_owner": {
      "track": "tenant_administration",
      "actions": ["tenant.membership.manage", "tenant.authorization.grant", "tenant.application.manage"],
      "mayDecideClientMobilization": false,
      "ceiling": "own_tenant",
      "grantableThroughRuntime": false,
      "mayGrantOnlyWithinOwnDelegationAndRoleCeiling": true
    },
    "hierarchy_admin": {
      "track": "administrative_delegation",
