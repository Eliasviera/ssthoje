{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sst-hoje.local/schemas/pcmso-risk-link.json",
  "title": "Vínculo rastreável PCMSO-PGR",
  "description": "Contrato de referência a riscos existentes; não define exames ou condutas clínicas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "companyId", "unitId", "inventoryId", "inventoryRevision", "riskItemIds", "medicalReview"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 140 },
    "companyId": { "type": "string", "minLength": 1, "maxLength": 140 },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 140 },
    "inventoryId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "inventoryRevision": { "type": "integer", "minimum": 1 },
    "riskItemIds": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "medicalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "reviewed"] },
        "reviewerUserId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "reviewed" } } }, "then": { "required": ["reviewerUserId", "reviewedAt"] } },
        { "if": { "properties": { "status": { "const": "pending" } } }, "then": { "not": { "anyOf": [{ "required": ["reviewerUserId"] }, { "required": ["reviewedAt"] }] } } }
      ]
    }
  }
}
