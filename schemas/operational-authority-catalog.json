    "client_policy_admin": {
      "track": "policy_administration",
      "actions": ["thirdparty.policy.manage"],
      "mayDecideClientMobilization": false,
      "requiredGrantScope": ["companyId", "unitId"],
      "policyChangesAreVersioned": true
    },
    "client_manager": {
      "track": "managerial_decision",
