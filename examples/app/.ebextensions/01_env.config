# A versão do Node NÃO é definida aqui: `aws:elasticbeanstalk:container:nodejs:NodeVersion`
# só vale para plataformas Amazon Linux AMI (AL1). Em AL2023 a versão vem do ramo
# de plataforma escolhido e de "engines" no package.json.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: "8080"
