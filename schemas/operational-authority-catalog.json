    "tenant.authorization.grant": {"track": "administrative", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId"], "delegation": "strictly_below_actor_ceiling", "audit": true},
    "tenant.application.manage": {"track": "administrative", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId"], "audit": true},
    "thirdparty.evidence.submit_own": {"track": "evidence_submission", "machineAllowed": true, "scope": ["tenantId", "thirdPartyId", "workflowId"], "audit": true},
    "thirdparty.status.read_own": {"track": "read_only", "machineAllowed": true, "scope": ["tenantId", "thirdPartyId", "workflowId"], "audit": true},
    "documents.read_scoped": {"track": "read_only", "machineAllowed": true, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId"], "audit": true},
    "thirdparty.analysis.recommend": {"track": "technical_recommendation", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "recordsBasis": true, "audit": true},
    "thirdparty.policy.manage": {"track": "policy_administration", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId"], "reasonRequired": true, "versioned": true, "audit": true},
    "thirdparty.requirement.set": {"track": "technical_authority", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "policyRequired": true, "recordsBasis": true, "audit": true},
    "thirdparty.technical.block": {"track": "technical_authority", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "policyRequired": true, "recordsBasis": true, "audit": true},
    "thirdparty.technical.release": {"track": "technical_authority", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "policyRequired": true, "denyWhenUnresolvedMandatoryBlock": true, "requiresCurrentFavorableReassessmentToResolveBlock": true, "recordsBasis": true, "audit": true},
    "thirdparty.mobilization.require_pre_entry_correction": {"track": "managerial_decision", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "decisionSnapshot": true, "audit": true},
    "thirdparty.mobilization.authorize_conditional_entry": {"track": "managerial_decision", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "decisionSnapshot": true, "policyRequired": true, "requiredPolicyEffect": "conditional_allowed", "pendingRemainsOpen": true, "audit": true},
    "thirdparty.analysis.return_to_sst": {"track": "workflow_routing", "machineAllowed": false, "scope": ["tenantId", "companyId", "unitId", "thirdPartyId", "workflowId"], "reasonRequired": true, "audit": true}
  },
  "policyEffects": ["recommendation", "requirement", "block", "conditional_allowed"],
  "policyReferenceRequiredFields": ["jurisdiction", "sourceId", "version", "item", "effectiveFrom", "scope", "reviewerUserId", "reviewedAt"],
  "policyReferenceOptionalFields": ["effectiveTo", "urlOrDocumentReference"],
  "grantRules": {
    "denyByDefault": true,
    "noSelfGrant": true,
    "noElevationAboveActorCeiling": true,
    "saas_masterDelegable": false,
    "tenant_ownerDelegableThroughRuntime": false,
    "administrativeRoleDoesNotImplyTechnicalOrManagerialActions": true
  },
  "authorizationOrder": ["principal_active", "tenant_active_and_mode", "grant_active", "scope_covers_target", "action_allowed", "transition_allowed", "policy_current_and_allows", "module_enabled", "technical_limits_available", "atomic_audit_commit"],
  "denyByDefault": true
