    },
    "consultancy_sst": {
      "track": "technical_recommendation",
      "actions": ["thirdparty.analysis.recommend"],
      "mayDecideClientMobilization": false,
      "requiredAssignment": ["companyId", "unitId", "thirdPartyId", "workflowId"]
    },
    "client_sst": {
      "track": "technical_authority",
      "actions": ["thirdparty.analysis.recommend", "thirdparty.requirement.set", "thirdparty.technical.block", "thirdparty.technical.release", "thirdparty.analysis.return_to_sst"],
      "mayDecideClientMobilization": false,
      "requiredAssignment": ["companyId", "unitId", "thirdPartyId", "workflowId"],
      "policyRequired": true
