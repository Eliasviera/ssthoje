# Copie para .env.local e preencha somente com valores fictícios locais.
# Gere o segredo da sessão com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SST_DEMO_EMAIL=
SST_DEMO_PASSWORD=
SST_DEMO_SST_EMAIL=
SST_DEMO_SST_PASSWORD=
SST_DEMO_TRABALHADOR_EMAIL=
SST_DEMO_TRABALHADOR_PASSWORD=
SST_DEMO_TENANT_B_EMAIL=
SST_DEMO_TENANT_B_PASSWORD=

# Conta médica fictícia local; configure a senha em .env.local
SST_DEMO_MEDICO_EMAIL=medico@ssthoje.local
SST_DEMO_MEDICO_PASSWORD=

# Conta fictícia da plataforma, sem vínculo às consultorias
SST_DEMO_MASTER_EMAIL=master@ssthoje.local
SST_DEMO_MASTER_PASSWORD=

# Conta cliente fictícia para a prova M22 local; não representa autoridade legal real.
SST_DEMO_CLIENT_EMAIL=cliente-m22@ssthoje.local
SST_DEMO_CLIENT_PASSWORD=

# Fonte do CMS local: postgres (padrão no dev:db); json apenas para retorno controlado.
SST_SITE_CMS_STORAGE=postgres

# Receptor Asaas: manter desativado até preparar conta e cobrança fictícias no sandbox.
# Não usar chave de API como token de webhook. Nunca colar segredos no chat/Git.
SST_ASAAS_SANDBOX_ENABLED=false
SST_ASAAS_WEBHOOK_TOKEN=
SST_ASAAS_SANDBOX_TENANT_ID=
SST_ASAAS_SANDBOX_PAYMENT_ID=
