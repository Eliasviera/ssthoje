# Variáveis para rodar o container na AWS (ECS Fargate ou EC2).
# Copie para um arquivo local .env.aws.local (nunca versionado) ou cadastre no
# AWS Secrets Manager / SSM Parameter Store e injete no serviço.
# NÃO preencha aqui com valores reais.

NODE_ENV=production
PORT=3000

# --- PostgreSQL (RDS) ---
# No RDS o usuário da aplicação deve ser o mesmo que tem permissão nas tabelas
# criadas pelas migrações. PGSSL=require ativa TLS.
PGHOST=
PGPORT=5432
# OBRIGATÓRIO manter "sst_hoje_dev": a migração 0001 concede CONNECT nesse nome
# e migrações aplicadas não podem ser editadas (o ledger valida o checksum).
PGDATABASE=sst_hoje_dev
PGUSER=
PGPASSWORD=
PGSSL=require

# --- Sessão ---
# 32+ bytes. Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Contas de demonstração / acesso inicial ---
# Em produção NÃO use as contas fictícias de desenvolvimento.
# Estas variáveis criam contas com senha vinda do ambiente; defina senhas fortes
# e remova as que não forem usadas.
SST_DEMO_EMAIL=
SST_DEMO_PASSWORD=
SST_DEMO_SST_EMAIL=
SST_DEMO_SST_PASSWORD=
SST_DEMO_TENANT_B_EMAIL=
SST_DEMO_TENANT_B_PASSWORD=
SST_DEMO_MEDICO_EMAIL=
SST_DEMO_MEDICO_PASSWORD=
SST_DEMO_MASTER_EMAIL=
SST_DEMO_MASTER_PASSWORD=
SST_DEMO_CLIENT_EMAIL=
SST_DEMO_CLIENT_PASSWORD=

# --- Armazenamento por Postgres ---
SST_SITE_CMS_STORAGE=postgres
SST_PCMSO_STORAGE=postgres

# --- Integrações ---
# Mantenha o sandbox desligado até existir conta real aprovada.
SST_ASAAS_SANDBOX_ENABLED=false
SST_ASAAS_WEBHOOK_TOKEN=
SST_ASAAS_SANDBOX_TENANT_ID=
SST_ASAAS_SANDBOX_PAYMENT_ID=
