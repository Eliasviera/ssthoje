{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tenant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "closed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "planId": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
