{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sst-hoje.local/schemas/esocial-s2240-timeline-candidate.json",
  "title": "Linha do tempo candidata de condições S-2240",
  "description": "Modelo interno append-only para rascunhos de períodos; não é histórico oficial do eSocial e não permite transmissão.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "status", "scope", "sourceLayout", "periods", "transmission"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "s2240_timeline_candidate" },
    "status": { "const": "internal_draft_only" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "companyId", "unitId", "workerRef"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "unitId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "workerRef": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    },
    "sourceLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceUrl", "verifiedAt"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "verifiedAt": { "type": "string", "format": "date" }
      }
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/period" }
    },
    "transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "adapter", "officialReceipt"],
      "properties": {
        "enabled": { "const": false },
        "adapter": { "const": "none" },
        "officialReceipt": { "const": null }
      }
    }
  },
  "$defs": {
    "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "uniqueItems": true },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodId", "revision", "state", "effectiveFrom", "effectiveUntil", "snapshot", "evidenceRefs", "review", "history"],
      "properties": {
        "periodId": { "type": "string", "minLength": 1, "maxLength": 140 },
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["draft", "pending_technical_review", "technically_reviewed", "client_approved", "superseded", "rejected"] },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveUntil": { "type": ["string", "null"], "format": "date" },
        "supersedesPeriodId": { "type": ["string", "null"], "maxLength": 140 },
        "changeFromPrevious": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reason", "changedSections", "confirmedUnchangedSections"],
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "changedSections": { "type": "array", "items": { "enum": ["worker_link", "environment", "sector", "activity", "agent", "protection", "responsible", "other"] }, "uniqueItems": true },
            "confirmedUnchangedSections": { "type": "array", "items": { "enum": ["worker_link", "environment", "sector", "activity", "agent", "protection", "responsible", "other"] }, "uniqueItems": true }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerLinkRef", "workplace", "activity", "environments", "agents", "protectionEvidenceRefs", "responsibles"],
          "properties": {
            "workerLinkRef": { "type": "string", "minLength": 1, "maxLength": 140 },
            "workplace": { "type": "object", "additionalProperties": false, "required": ["value", "sourceRefs"], "properties": { "value": { "type": ["string", "null"], "maxLength": 2000 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } } },
            "activity": { "type": "object", "additionalProperties": false, "required": ["value", "sourceRefs"], "properties": { "value": { "type": ["string", "null"], "maxLength": 3000 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } } },
            "environments": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["environmentRef", "sectorDescription", "sourceRefs"], "properties": { "environmentRef": { "type": "string", "minLength": 1, "maxLength": 140 }, "sectorDescription": { "type": ["string", "null"], "maxLength": 500 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } } } },
            "agents": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["table24Code", "description", "reviewState", "sourceRefs"], "properties": { "table24Code": { "type": ["string", "null"], "maxLength": 30 }, "description": { "type": ["string", "null"], "maxLength": 1000 }, "reviewState": { "enum": ["missing", "reported_unverified", "pending_human_review", "source_reviewed", "rejected"] }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" } } } },
            "protectionEvidenceRefs": { "$ref": "#/$defs/sourceRefs" },
            "responsibles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["personRef", "professionalBody", "registrationRef", "sourceRefs", "reviewState"], "properties": { "personRef": { "type": ["string", "null"], "maxLength": 140 }, "professionalBody": { "type": ["string", "null"], "maxLength": 20 }, "registrationRef": { "type": ["string", "null"], "maxLength": 80 }, "sourceRefs": { "$ref": "#/$defs/sourceRefs" }, "reviewState": { "enum": ["missing", "pending_human_review", "source_reviewed", "rejected"] } } } }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/sourceRefs" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["technicalReviewerRef", "technicalReviewedAt", "clientApproverRef", "clientApprovedAt", "snapshotHash"],
          "properties": {
            "technicalReviewerRef": { "type": ["string", "null"], "maxLength": 140 },
            "technicalReviewedAt": { "type": ["string", "null"], "format": "date-time" },
            "clientApproverRef": { "type": ["string", "null"], "maxLength": 140 },
            "clientApprovedAt": { "type": ["string", "null"], "format": "date-time" },
            "snapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "history": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["action", "actorRef", "occurredAt", "note"], "properties": { "action": { "enum": ["created", "edited", "submitted_for_review", "technical_reviewed", "client_approved", "rejected", "superseded"] }, "actorRef": { "type": "string", "minLength": 1, "maxLength": 140 }, "occurredAt": { "type": "string", "format": "date-time" }, "note": { "type": "string", "maxLength": 1000 } } } }
      }
    }
  }
}
